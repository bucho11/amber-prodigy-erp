{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@prodigy/contracts": ["packages/contracts/src/index.ts"],
      "@prodigy/db": ["packages/db/src/index.ts"],
      "@prodigy/ai": ["packages/ai/src/index.ts"]
    }
  }
}
