{
  "name": "amber-prodigy-erp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p test/tsconfig.json",
    "build": "npm run build -w @prodigy/web && npm run build -w @prodigy/api",
    "start": "node apps/api/dist/index.js",
    "dev": "npm run build && npm run start",
    "test": "tsx test/run.ts",
    "audit": "tsx scripts/audit/audit.ts",
    "eval": "tsx scripts/eval/eval.ts"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.11.3",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^20.16.10",
    "puppeteer-core": "^25.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
